---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm";
import { SITE } from "../config/site";
---

<Layout
  title="Contact"
  description="Tell Skyline Solutions what your team currently does manually — we'll explore whether AI or custom software can make it faster, simpler, or more reliable."
  path="/contact"
>
  <section class="border-b border-line py-20 md:py-28">
    <div class="container-xl">
      <div class="grid gap-14 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
        <div data-reveal>
          <p class="eyebrow mb-6">Contact</p>
          <h1 class="text-3xl md:text-4xl font-semibold text-white leading-tight">
            Something to automate, or something to build?
          </h1>
          <p class="mt-5 text-base leading-relaxed text-text-dim">
            Tell us what your team does by hand, or what system you wish existed.
            We'll reply with an honest read on whether it's worth doing.
          </p>

          <div class="mt-10 space-y-2 border-t border-line pt-8">
            <p class="text-sm font-medium text-white">Email</p>
            <a href={`mailto:${SITE.email}`} class="text-sm text-accent-400 hover:text-accent-300">
              {SITE.email}
            </a>
          </div>
        </div>

        <div class="rounded-2xl border border-line bg-ink-900/40 p-6 md:p-9" data-reveal>
          <ContactForm client:load />
        </div>
      </div>
    </div>
  </section>
</Layout>
