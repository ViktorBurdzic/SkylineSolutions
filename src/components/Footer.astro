---
import { SITE } from "../config/site";
import { withBase } from "../utils/url";

const year = new Date().getFullYear();

const links = [
  { href: withBase("/#services"), label: "Services" },
  { href: withBase("/#automate"), label: "What We Automate" },
  { href: withBase("/#process"), label: "How It Works" },
  { href: withBase("/#why"), label: "Why Skyline" },
  { href: withBase("/#technology"), label: "Technology" },
  { href: withBase("/contact"), label: "Contact" },
];
---

<footer class="border-t border-line">
  <div class="container-xl py-16">
    <div class="flex flex-col gap-12 md:flex-row md:justify-between">
      <div class="max-w-sm">
        <a href={withBase("/")} class="flex items-center gap-3">
          <img src={withBase("/images/logo-mark.svg")} alt="" width="32" height="32" class="h-8 w-8" />
          <span class="font-semibold tracking-tight text-white">
            Skyline <span class="text-text-dim font-normal">Solutions</span>
          </span>
        </a>
        <p class="mt-4 text-sm leading-relaxed text-text-dim">
          Software engineering and AI automation for businesses that want their existing systems to do more —
          without replacing them.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:gap-16">
        <div>
          <p class="eyebrow mb-4">Site</p>
          <ul class="space-y-2.5">
            {links.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-text-dim hover:text-white transition-colors duration-200">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <p class="eyebrow mb-4">Contact</p>
          <ul class="space-y-2.5">
            <li>
              <a href={`mailto:${SITE.email}`} class="text-sm text-text-dim hover:text-white transition-colors duration-200">
                {SITE.email}
              </a>
            </li>
            <li>
              <a href={withBase("/contact")} class="text-sm text-text-dim hover:text-white transition-colors duration-200">
                Contact form
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-4 border-t border-line pt-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-xs text-text-faint">&copy; {year} Skyline Solutions. All rights reserved.</p>
      <p class="text-xs text-text-faint">Built with .NET-grade engineering discipline.</p>
    </div>
  </div>
</footer>
