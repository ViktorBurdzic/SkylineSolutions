---
interface Props {
  eyebrow: string;
  title: string;
  accent?: string;
  description?: string;
  align?: "left" | "center";
  class?: string;
}

const { eyebrow, title, accent, description, align = "left", class: className = "" } = Astro.props;
---

<div class:list={["max-w-3xl", align === "center" && "mx-auto text-center", className]} data-reveal>
  <p class="eyebrow mb-5">{eyebrow}</p>
  <h2 class="text-balance text-3xl font-semibold leading-[1.1] tracking-tight text-white md:text-5xl">
    {title}{accent && <> <span class="text-gradient">{accent}</span></>}
  </h2>
  {description && <p class="mt-5 max-w-xl text-base leading-relaxed text-text-dim md:text-lg">{description}</p>}
</div>
