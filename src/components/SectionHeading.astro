---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  class?: string;
}

const { eyebrow, title, description, align = "left", class: className = "" } = Astro.props;
---

<div class:list={["max-w-2xl", align === "center" && "mx-auto text-center", className]} data-reveal>
  <p class="eyebrow mb-4">{eyebrow}</p>
  <h2 class="text-3xl md:text-4xl font-semibold text-white leading-tight">{title}</h2>
  {description && <p class="mt-4 text-base md:text-lg text-text-dim leading-relaxed">{description}</p>}
</div>
