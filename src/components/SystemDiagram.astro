---
interface Props {
  variant?: "hero" | "full";
  class?: string;
}

const { variant = "full", class: className = "" } = Astro.props;

const inputs =
  variant === "hero"
    ? ["CRM", "ERP", "Database", "APIs", "Documents"]
    : ["CRM", "ERP", "SQL", "APIs", "Documents", "Legacy Apps"];

const outputs =
  variant === "hero"
    ? ["Automated Workflows"]
    : ["AI Agents", "Automation", "Knowledge", "Decision Support", "Workflows"];
---

<div class={`relative ${className}`} data-reveal>
  <div class="rounded-2xl border border-line bg-ink-900/60 p-6 md:p-10 noise-surface">
    <!-- Tier 1: existing systems -->
    <div>
      <p class="eyebrow mb-4 text-center">Existing Systems</p>
      <div class="flex flex-wrap justify-center gap-2.5">
        {inputs.map((item) => (
          <span class="rounded-md border border-line-strong bg-ink-800 px-3.5 py-2 text-sm text-text-dim font-mono">
            {item}
          </span>
        ))}
      </div>
    </div>

    <!-- Connector -->
    <div class="diagram-connector" aria-hidden="true">
      <span class="diagram-line"></span>
      <span class="diagram-dot"></span>
    </div>

    <!-- Tier 2: Skyline AI layer -->
    <div class="flex justify-center">
      <div class="diagram-ai-layer w-full max-w-md rounded-xl border border-accent-500/40 px-6 py-5 text-center shadow-glow">
        <p class="font-semibold text-white text-lg">Skyline AI Layer</p>
        <p class="mt-1 text-xs font-mono text-text-dim tracking-wide">orchestration · context · guardrails</p>
      </div>
    </div>

    <!-- Connector -->
    <div class="diagram-connector" aria-hidden="true">
      <span class="diagram-line"></span>
      <span class="diagram-dot" style="animation-delay: 0.9s;"></span>
    </div>

    <!-- Tier 3: outputs -->
    <div>
      <p class="eyebrow mb-4 text-center">{variant === "hero" ? "Result" : "Automation & Decision Support"}</p>
      <div class="flex flex-wrap justify-center gap-2.5">
        {outputs.map((item) =>
          variant === "hero" ? (
            <span class="rounded-md bg-accent-500 px-4 py-2.5 text-sm font-medium text-white">{item}</span>
          ) : (
            <span class="rounded-md border border-line-strong bg-ink-800 px-3.5 py-2 text-sm text-text font-mono">
              {item}
            </span>
          )
        )}
      </div>
    </div>

    {variant === "full" && (
      <>
        <div class="diagram-connector" aria-hidden="true">
          <span class="diagram-line"></span>
          <span class="diagram-dot" style="animation-delay: 1.8s;"></span>
        </div>
        <div class="flex justify-center">
          <span class="rounded-md bg-accent-500 px-5 py-3 text-sm font-medium text-white">Business Results</span>
        </div>
      </>
    )}
  </div>
</div>

<style>
  .diagram-connector {
    position: relative;
    height: 2.5rem;
    display: flex;
    justify-content: center;
  }

  .diagram-ai-layer {
    background: linear-gradient(to bottom, rgba(59, 130, 246, 0.15), rgba(34, 211, 238, 0.05));
  }

  .diagram-line {
    width: 1px;
    height: 100%;
    background: linear-gradient(to bottom, var(--color-line-strong), var(--color-accent-500), var(--color-line-strong));
  }

  .diagram-dot {
    position: absolute;
    top: 0;
    left: 50%;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    border-radius: 9999px;
    background: var(--color-cyan-400);
    box-shadow: 0 0 8px 2px rgba(34, 211, 238, 0.6);
    animation: travel 2.4s ease-in-out infinite;
  }

  @keyframes travel {
    0% {
      top: 0%;
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      top: 100%;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .diagram-dot {
      animation: none;
      opacity: 0;
    }
  }
</style>
