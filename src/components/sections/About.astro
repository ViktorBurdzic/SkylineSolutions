---
import { withBase } from "../../utils/url";

// To use your real photo: add it as public/images/director.jpg, then change
// the src below from "/images/director-placeholder.svg" to "/images/director.jpg".
const focusAreas = [
  ".NET / C#",
  "CRM Systems",
  "Enterprise Software",
  "SQL & Databases",
  "System Integrations",
  "AI-Assisted Development",
];
---

<section id="about" class="border-b border-line py-24 md:py-32 scroll-mt-20">
  <div class="container-xl">
    <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <div data-reveal>
        <div class="overflow-hidden rounded-xl border border-line">
          <img
            src={withBase("/images/director-placeholder.svg")}
            alt="Portrait of the Skyline Solutions director — replace with a professional photo"
            width="480"
            height="560"
            class="h-auto w-full object-cover"
            loading="lazy"
          />
        </div>
      </div>

      <div data-reveal>
        <p class="eyebrow mb-6">About the Director</p>
        <h2 class="text-3xl md:text-4xl font-semibold text-white leading-tight">Viktor Burdzic</h2>
        <p class="mt-1 text-text-dim">Founder &amp; Director, Senior .NET / Software Engineer</p>

        <p class="mt-6 max-w-xl text-base leading-relaxed text-text-dim">
          I founded Skyline Solutions after years of working directly inside enterprise CRM and business
          software — writing C#, designing SQL schemas, building integrations, and maintaining large existing
          codebases. That work is the foundation the company is built on.
        </p>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-text-dim">
          Alongside that, I use AI coding tools in real, day-to-day software development — not as an
          experiment, but as part of how modern software gets built. Skyline exists to bring that same
          practical approach to businesses that want AI to do more than answer questions.
        </p>

        <div class="mt-9 flex flex-wrap gap-2.5">
          {focusAreas.map((item) => (
            <span class="rounded-md border border-line-strong bg-ink-800 px-3.5 py-2 text-sm text-text-dim font-mono">
              {item}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
