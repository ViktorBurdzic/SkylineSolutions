---
import SectionHeading from "../SectionHeading.astro";
import { services } from "../../data/services";
---

<section id="services" class="border-b border-line py-28 md:py-40 scroll-mt-20">
  <div class="container-xl">
    <SectionHeading eyebrow="Services" title="Three ways we make your" accent="software work harder." />

    <div class="mt-20 grid gap-6 lg:grid-cols-3">
      {services.map((service, i) => (
        <article
          class="spotlight group relative flex flex-col overflow-hidden rounded-2xl border border-line bg-ink-900/40 p-8 transition-all duration-500 hover:-translate-y-1.5 hover:border-accent-500/40"
          data-spotlight
          data-reveal
          style={`transition-delay: ${i * 80}ms`}
        >
          <span class="font-mono text-xs tracking-widest text-accent-400">{service.tag}</span>
          <h3 class="mt-6 text-2xl font-semibold tracking-tight text-white">{service.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-text-dim">{service.description}</p>
          <span class="hairline-grad absolute inset-x-0 bottom-0 h-px"></span>
        </article>
      ))}
    </div>
  </div>
</section>
