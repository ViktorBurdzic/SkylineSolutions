---
import SectionHeading from "../SectionHeading.astro";
import { automationExamples } from "../../data/automation";
---

<section id="automate" class="border-b border-line py-28 md:py-40 scroll-mt-20">
  <div class="container-xl">
    <SectionHeading eyebrow="What Can We Automate?" title="Examples, not a" accent="finished product list." />

    <div class="mt-20 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {automationExamples.map((item, i) => (
        <div
          class="spotlight group relative overflow-hidden rounded-2xl border border-line bg-ink-900/40 p-7 transition-all duration-500 hover:-translate-y-1.5 hover:border-accent-500/40"
          data-spotlight
          data-reveal
          style={`transition-delay: ${(i % 3) * 80}ms`}
        >
          <h3 class="text-lg font-semibold tracking-tight text-white">{item.title}</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-text-dim">{item.description}</p>
          <span class="hairline-grad absolute inset-x-0 bottom-0 h-px"></span>
        </div>
      ))}
    </div>
  </div>
</section>
