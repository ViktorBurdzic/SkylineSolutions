---
import SectionHeading from "../SectionHeading.astro";
import CaseStudyReel from "../CaseStudyReel.astro";
import { caseStudies } from "../../data/caseStudies";
---

{
  /* Renders nothing while there's no work to show, so the page can never carry
     an empty "proof" section. */
  caseStudies.length > 0 && (
    <section id="work" class="border-b border-line py-28 md:py-40 scroll-mt-20">
      <div class="container-xl">
        <SectionHeading eyebrow="Work" title="One job," accent="start to finish." />

        <div class="cases">
          {caseStudies.map((study) => (
            <CaseStudyReel study={study} />
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .cases {
    margin-top: 3.5rem;
    display: grid;
    gap: 1.5rem;
  }
</style>
