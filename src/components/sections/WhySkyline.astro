---
const pillars = [
  { n: "01", label: "Software engineering", detail: "Production code, not prototypes." },
  { n: "02", label: "Enterprise systems", detail: "CRM, ERP, and the data behind them." },
  { n: "03", label: "Process understanding", detail: "Knowing what's worth automating." },
  { n: "04", label: "AI & integration", detail: "Models wired to live systems, safely." },
];
---

<section id="why" class="border-b border-line py-28 md:py-40 scroll-mt-20">
  <div class="container-xl">
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <p class="eyebrow mb-6">Why Skyline</p>
      <h2 class="text-balance text-3xl font-semibold leading-[1.1] tracking-tight text-white md:text-5xl">
        Anyone can wire up a chatbot.
        <span class="text-gradient">Fewer can wire up your CRM.</span>
      </h2>
    </div>

    <div class="mt-20 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {pillars.map((pillar, i) => (
        <div
          class="group relative bg-ink-950 p-8 transition-colors duration-500 hover:bg-ink-900"
          data-reveal
          style={`transition-delay: ${i * 80}ms`}
        >
          <span class="font-mono text-xs tracking-widest text-text-faint transition-colors duration-500 group-hover:text-accent-400">
            {pillar.n}
          </span>
          <p class="mt-5 text-base font-semibold text-white">{pillar.label}</p>
          <p class="mt-2 text-sm leading-relaxed text-text-dim">{pillar.detail}</p>
          <span class="hairline-grad absolute inset-x-0 bottom-0 h-px"></span>
        </div>
      ))}
    </div>
  </div>
</section>
