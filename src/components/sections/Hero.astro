---
import Button from "../Button.astro";
import SystemDiagram from "../SystemDiagram.astro";
import { withBase } from "../../utils/url";
---

<section class="relative overflow-hidden border-b border-line">
  <div class="pointer-events-none absolute inset-0 noise-surface opacity-40"></div>
  <div
    class="pointer-events-none absolute -top-40 left-1/2 h-[36rem] w-[36rem] -translate-x-1/2 rounded-full bg-accent-500/10 blur-3xl"
  >
  </div>

  <div class="container-xl relative py-20 md:py-28 lg:py-32">
    <div class="grid gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:gap-10">
      <div>
        <p class="eyebrow mb-6" data-reveal>Software Engineering &amp; AI Automation</p>
        <h1
          class="text-4xl font-semibold leading-[1.08] text-white sm:text-5xl lg:text-[3.4rem]"
          data-reveal
        >
          Modernize your business software with AI.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-text-dim" data-reveal>
          Skyline Solutions integrates AI agents, automation, and modern software engineering into the CRM,
          ERP, and business systems you already run — automating real workflows without forcing you to
          replace what already works.
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row" data-reveal>
          <Button href={withBase("/contact")} variant="primary">Discuss Your Project</Button>
          <Button href="#automate" variant="secondary">See What We Can Automate</Button>
        </div>

        <div class="mt-12 flex flex-wrap gap-x-8 gap-y-3 text-sm text-text-faint font-mono" data-reveal>
          <span>.NET / C#</span>
          <span>CRM &amp; ERP Integrations</span>
          <span>AI Agents</span>
          <span>Enterprise Software</span>
        </div>
      </div>

      <SystemDiagram variant="hero" />
    </div>
  </div>
</section>
