---
import SectionHeading from "../SectionHeading.astro";
import Marquee from "../Marquee.astro";
import { techGroups } from "../../data/tech";

const rowA = techGroups[0].items;
const rowB = [...techGroups[1].items, ...techGroups[2].items];
---

<section id="technology" class="border-b border-line py-28 md:py-40 scroll-mt-20">
  <div class="container-xl">
    <SectionHeading eyebrow="Technology" title="The stack" accent="behind the work." align="center" />
  </div>

  <div class="mt-20 space-y-4">
    <Marquee items={rowA} duration={26} />
    <Marquee items={rowB} reverse duration={22} />
  </div>
</section>
