---
import SectionHeading from "../SectionHeading.astro";

const capabilities = [
  {
    title: "CRM-connected automation",
    detail: "Workflows that read from and act on CRM data — built on real integration patterns, not mockups.",
  },
  {
    title: "Legacy system integration",
    detail: "Connecting older ASP.NET / SQL-based applications to modern APIs and AI tooling without a rewrite.",
  },
  {
    title: "Document & knowledge retrieval",
    detail: "Making internal documentation and records queryable in plain language.",
  },
];
---

<section id="capabilities" class="border-b border-line py-24 md:py-32 scroll-mt-20">
  <div class="container-xl">
    <SectionHeading
      eyebrow="Selected Capabilities"
      title="Case studies are on the way."
      description="Skyline Solutions is a new company built on experience earned inside real enterprise systems. Rather than invent client stories, here's the kind of work we're set up to do — with public case studies to follow as engagements complete."
    />

    <div class="mt-16 grid gap-5 md:grid-cols-3">
      {capabilities.map((item, i) => (
        <div class="rounded-xl border border-dashed border-line-strong p-6" data-reveal style={`transition-delay: ${i * 90}ms`}>
          <h3 class="text-base font-semibold text-white">{item.title}</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-text-dim">{item.detail}</p>
        </div>
      ))}
    </div>
  </div>
</section>
