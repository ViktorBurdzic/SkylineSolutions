---
import Button from "../Button.astro";
import { withBase } from "../../utils/url";
---

<section class="py-28 md:py-40">
  <div class="container-xl">
    <div class="relative overflow-hidden rounded-3xl border border-line bg-ink-900/60 px-6 py-16 text-center noise-surface sm:px-8 sm:py-20 md:px-16 md:py-28">
      <div
        class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(circle_at_50%_0%,rgba(59,130,246,0.18),transparent_60%)]"
      >
      </div>
      <p class="eyebrow mb-6" data-reveal>Get Started</p>
      <h2
        class="mx-auto max-w-3xl text-balance text-3xl font-semibold leading-[1.1] tracking-tight text-white md:text-5xl"
        data-reveal
        data-split
      >
        Something to automate, or <span class="text-gradient">something to build?</span>
      </h2>
      <div class="mt-10" data-reveal>
        <Button href={withBase("/contact")} variant="primary">Start a Conversation</Button>
      </div>
    </div>
  </div>
</section>
