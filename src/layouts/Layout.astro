---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { SITE, AUTHOR } from "../config/site";
import { withBase } from "../utils/url";

interface Props {
  title: string;
  description?: string;
  path?: string;
  noindex?: boolean;
}

const { title, description = SITE.description, path = "/", noindex = false } = Astro.props;

const pageTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
// `path` is root-relative, so it must carry the configured base path. That is
// empty on the current apex-domain deploy, but keeping it means a move back to
// a subpath deploy doesn't silently break every canonical URL.
// Astro's directory build format serves every page at a trailing slash, and
// that is the form @astrojs/sitemap emits — so the canonical has to match, or
// each page is advertised under two URLs that search engines count separately.
const canonicalPath = path.endsWith("/") ? path : `${path}/`;
const canonicalURL = new URL(withBase(canonicalPath), SITE.url).toString();
// PNG, not the SVG it is generated from: LinkedIn, Facebook and X all refuse
// to render SVG previews and fall back to a bare text link. Regenerate with
// scripts/og-image.mjs after editing og-cover.svg.
const ogImageURL = new URL(withBase("/images/og-cover.png"), SITE.url).toString();

/*
 * Two linked nodes rather than one, in a @graph so they can reference each
 * other by @id:
 *
 * - the business, carrying `sameAs` — the explicit statement that the LinkedIn
 *   and GitHub profiles are this same entity. "Skyline Solutions" is a name
 *   several unrelated companies already use, so corroborating profiles are what
 *   let a search engine tell them apart.
 * - the site itself, which is what Google reads to decide the site name shown
 *   above a search result instead of deriving one from the domain.
 */
const orgId = `${SITE.url}/#organization`;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.name,
      description: SITE.description,
      publisher: { "@id": orgId },
      inLanguage: SITE.locale,
    },
    {
      "@type": "ProfessionalService",
      "@id": orgId,
      name: SITE.name,
      url: SITE.url,
      description: SITE.description,
      email: SITE.email,
      logo: new URL(withBase("/images/linkedin-logo.png"), SITE.url).toString(),
      image: ogImageURL,
      sameAs: SITE.profiles,
      areaServed: "Worldwide",
      // A one-person practice: naming the founder lets search engines tie the
      // business to a real, verifiable person rather than an anonymous brand.
      founder: {
        "@type": "Person",
        name: AUTHOR.name,
        jobTitle: AUTHOR.role,
        sameAs: [AUTHOR.linkedin],
      },
      knowsAbout: [
        ".NET development",
        "C# development",
        "CRM development",
        "AI automation",
        "AI agents",
        "Enterprise software integration",
        "Software modernization",
        "UX and interface design",
        "Software testing and QA",
        "Software project management",
      ],
    },
  ],
};
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <script is:inline>document.documentElement.classList.add("js");</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name} — AI automation for business software`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <meta name="theme-color" content="#05070a" />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="min-h-screen bg-ink-950 text-text">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-accent-500 focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
      );

      document.querySelectorAll("[data-reveal]").forEach((el) => observer.observe(el));

      // Feeds the cursor position to `.spotlight::before` so the highlight
      // follows the pointer across each card.
      document.querySelectorAll<HTMLElement>("[data-spotlight]").forEach((card) => {
        card.addEventListener("pointermove", (event) => {
          const rect = card.getBoundingClientRect();
          card.style.setProperty("--mx", `${event.clientX - rect.left}px`);
          card.style.setProperty("--my", `${event.clientY - rect.top}px`);
        });
      });

      // Word-split headings, counters, magnetic/tilt pointer effects, scroll
      // velocity, progress bar and the trailing cursor. All opt-in per element.
      import("../scripts/motion").then(({ initMotion }) => initMotion());
    </script>
  </body>
</html>
